+    /**
+     * Keyboard PIN input: typing a PIN digit on the lockscreen, even with the screen off, brings up
+     * the PIN bouncer and enters the digit, so the user doesn't have to swipe first. Digits typed
+     * before the PIN view is ready are held in [keyboardPinDigitBuffer] and typed, in order, once the
+     * bouncer has finished appearing.
+     */
+    private fun dispatchKeyboardPinDigit(event: KeyEvent): Boolean {
+        if (SceneContainerFlag.isEnabled) return false
+        if (event.action != KeyEvent.ACTION_DOWN || event.repeatCount != 0) return false
+        if (statusBarStateController.state != StatusBarState.KEYGUARD) return false
+        // Once the PIN view is up, digits go straight to it, unless earlier digits are still
+        // waiting for it (then queue behind them to keep the order).
+        if (statusBarKeyguardViewManager.isBouncerShowing && keyboardPinDigitBuffer.isEmpty) {
+            return false
+        }
+        val digit = keyboardPinDigit(event)
+        if (digit < 0) return false
+
+        Log.d(TAG, "Keyboard PIN: digit held until the PIN view is ready")
+        keyboardPinDigitBuffer.add(digit)
+        pinShowAttempts = 0
+        pinHandler.removeCallbacks(flushPinDigits)
+        pinHandler.post(flushPinDigits)
+        return true
+    }
+
+    private fun keyboardPinDigit(event: KeyEvent): Int {
+        if (
+            Settings.Secure.getInt(context.contentResolver, KEYBOARD_PIN_INPUT, 1) != 1 ||
+                lockPatternUtils.getCredentialTypeForUser(userTracker.userId) !=
+                    LockPatternUtils.CREDENTIAL_TYPE_PIN
+        ) {
+            return -1
+        }
+        val keyCode = event.keyCode
+        if (keyCode in KeyEvent.KEYCODE_0..KeyEvent.KEYCODE_9) return keyCode - KeyEvent.KEYCODE_0
+        val unicode =
+            event.keyCharacterMap.get(keyCode, KeyEvent.META_ALT_ON or KeyEvent.META_ALT_LEFT_ON)
+        return if (unicode >= '0'.code && unicode <= '9'.code) unicode - '0'.code else -1
+    }
+
+    /**
+     * Shows the PIN bouncer once the device is awake and, once it has finished appearing, types the
+     * held digits into it as normal key presses. Drops the digits if the bouncer never shows.
+     */
+    private val flushPinDigits: Runnable = Runnable {
+        if (keyboardPinDigitBuffer.isEmpty) return@Runnable
+        if (isDeviceAwake() && !statusBarKeyguardViewManager.primaryBouncerIsOrWillBeShowing()) {
+            statusBarKeyguardViewManager.showPrimaryBouncer(true, "Keyboard PIN input")
+        }
+        val root = readyPinViewRoot()
+        if (root != null) {
+            Log.d(TAG, "Keyboard PIN: PIN view ready, typing held digits")
+            for (digit in keyboardPinDigitBuffer.drain()) {
+                val keyCode = KeyEvent.KEYCODE_0 + digit
+                root.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, keyCode))
+                root.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_UP, keyCode))
+            }
+        } else if (++pinShowAttempts < PIN_SHOW_MAX_ATTEMPTS) {
+            pinHandler.postDelayed(flushPinDigits, PIN_SHOW_RETRY_MS)
+        } else {
+            keyboardPinDigitBuffer.clear()
+        }
+    }
+
+    /**
+     * The shade window's root view once the bouncer has finished appearing and its PIN field is
+     * focused and visible. Digits typed earlier are wiped when the bouncer resets while showing.
+     */
+    private fun readyPinViewRoot(): View? {
+        val step = keyguardTransitionInteractor.get().transitionState.value
+        if (step.to != KeyguardState.PRIMARY_BOUNCER ||
+            step.transitionState != TransitionState.FINISHED
+        ) {
+            return null
+        }
+        val root = statusBarKeyguardViewManager.viewRootImpl?.view ?: return null
+        val focused = root.findFocus() ?: return null
+        return if (root.hasWindowFocus() && focused.id == R.id.pinEntry && focused.isShown) {
+            root
+        } else {
+            null
+        }
+    }
