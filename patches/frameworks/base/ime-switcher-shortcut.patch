+    /**
+     * Whether the key opens the IME picker, per {@link Settings.Secure#IME_SWITCHER_SHORTCUT}:
+     * 0 = Alt+Enter (default), 1 = Shift+Space, 2 = Ctrl key, 3 = SYM key. Keyboard apps use
+     * SYM for their own symbol picker, so it is no longer the default.
+     */
+    private boolean isImeSwitcherShortcut(KeyEvent keyEvent) {
+        final int mode = mCurRootView == null ? 0 : Settings.Secure.getInt(
+                mCurRootView.mContext.getContentResolver(),
+                Settings.Secure.IME_SWITCHER_SHORTCUT, 0);
+        final int keyCode = keyEvent.getKeyCode();
+        switch (mode) {
+            case 1:
+                return keyCode == KeyEvent.KEYCODE_SPACE && keyEvent.isShiftPressed();
+            case 2:
+                return keyCode == KeyEvent.KEYCODE_CTRL_LEFT
+                        || keyCode == KeyEvent.KEYCODE_CTRL_RIGHT
+                        || keyCode == KeyEvent.KEYCODE_FUNCTION;
+            case 3:
+                return keyCode == KeyEvent.KEYCODE_SYM;
+            default:
+                return keyCode == KeyEvent.KEYCODE_ENTER && keyEvent.isAltPressed();
+        }
+    }
