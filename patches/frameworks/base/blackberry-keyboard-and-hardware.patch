+package com.android.systemui.keyguard.domain.interactor
+
+import com.android.systemui.dagger.SysUISingleton
+import javax.inject.Inject
+
+/**
+ * Keyboard PIN input: PIN digits typed on the lockscreen before the PIN bouncer is ready. The PIN
+ * view takes them once it has resumed (after its text has been reset), so none are lost. Only
+ * used on the main thread.
+ */
+@SysUISingleton
+class KeyboardPinDigitBuffer @Inject constructor() {
+    private val digits = ArrayDeque<Int>()
+
+    val isEmpty: Boolean
+        get() = digits.isEmpty()
+
+    fun add(digit: Int) {
+        digits.addLast(digit)
+    }
+
+    fun clear() {
+        digits.clear()
+    }
+
+    /** Removes and returns the queued digits, in the order they were typed. */
+    fun drain(): List<Int> {
+        val queued = digits.toList()
+        digits.clear()
+        return queued
+    }
+}
diff --git a/services/core/java/com/android/server/power/AuxBacklightController.java b/services/core/java/com/android/server/power/AuxBacklightController.java
new file mode 100644
index 000000000..08c3a54a1
--- /dev/null
+++ b/services/core/java/com/android/server/power/AuxBacklightController.java
@@ -0,0 +1,142 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.power;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.PowerManager;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+import com.android.server.lights.LightsManager;
+import com.android.server.lights.LogicalLight;
+
+/**
+ * Drives the keyboard and navigation button backlights of devices that have them.
+ *
+ * The levels come from the {@code keyboard_brightness} and {@code button_brightness} secure
+ * settings (0.0 to 1.0, written by the device settings app). Both lights are on, at the
+ * configured level, while the device is interactive and off otherwise. If
+ * {@code button_backlight_timeout} is set (milliseconds), they also turn off that long after the
+ * last user activity and come back on with the next one.
+ */
+final class AuxBacklightController {
+    private static final String KEY_KEYBOARD_BRIGHTNESS = "keyboard_brightness";
+    private static final String KEY_BUTTON_BRIGHTNESS = "button_brightness";
+    private static final String KEY_TIMEOUT = "button_backlight_timeout";
+    private static final float DEFAULT_LEVEL = 1.0f;
+
+    private final Context mContext;
+    private final LightsManager mLightsManager;
+    private final Handler mHandler;
+
+    private final Runnable mTimeoutRunnable = this::turnOffForTimeout;
+    private boolean mTimedOut;
+
+    private final ContentObserver mObserver;
+    private final BroadcastReceiver mScreenReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            apply();
+        }
+    };
+
+    AuxBacklightController(Context context, LightsManager lightsManager, Handler handler) {
+        mContext = context;
+        mLightsManager = lightsManager;
+        mHandler = handler;
+        mObserver = new ContentObserver(handler) {
+            @Override
+            public void onChange(boolean selfChange, Uri uri) {
+                apply();
+            }
+        };
+    }
+
+    void start() {
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(KEY_KEYBOARD_BRIGHTNESS), false, mObserver,
+                UserHandle.USER_ALL);
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(KEY_BUTTON_BRIGHTNESS), false, mObserver,
+                UserHandle.USER_ALL);
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(KEY_TIMEOUT), false, mObserver, UserHandle.USER_ALL);
+
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(Intent.ACTION_SCREEN_ON);
+        filter.addAction(Intent.ACTION_SCREEN_OFF);
+        filter.addAction(Intent.ACTION_USER_SWITCHED);
+        mContext.registerReceiver(mScreenReceiver, filter, null, mHandler);
+
+        apply();
+    }
+
+    /** Called when the user touches the screen or presses a key. */
+    void onUserActivity() {
+        mHandler.post(() -> {
+            if (mTimedOut) {
+                mTimedOut = false;
+                apply();
+            } else if (timeoutMs() > 0) {
+                scheduleTimeout();
+            }
+        });
+    }
+
+    private long timeoutMs() {
+        return Math.max(0, Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                KEY_TIMEOUT, 0, UserHandle.USER_CURRENT));
+    }
+
+    private void scheduleTimeout() {
+        mHandler.removeCallbacks(mTimeoutRunnable);
+        long timeout = timeoutMs();
+        if (timeout > 0) {
+            mHandler.postDelayed(mTimeoutRunnable, timeout);
+        }
+    }
+
+    private void turnOffForTimeout() {
+        mTimedOut = true;
+        setLight(LightsManager.LIGHT_ID_KEYBOARD, 0f);
+        setLight(LightsManager.LIGHT_ID_BUTTONS, 0f);
+    }
+
+    private void apply() {
+        PowerManager pm = mContext.getSystemService(PowerManager.class);
+        boolean on = pm != null && pm.isInteractive();
+        mHandler.removeCallbacks(mTimeoutRunnable);
+        mTimedOut = false;
+        if (on) {
+            scheduleTimeout();
+        }
+        setLight(LightsManager.LIGHT_ID_KEYBOARD, on ? level(KEY_KEYBOARD_BRIGHTNESS) : 0f);
+        setLight(LightsManager.LIGHT_ID_BUTTONS, on ? level(KEY_BUTTON_BRIGHTNESS) : 0f);
+    }
+
+    private float level(String key) {
+        float value = Settings.Secure.getFloatForUser(mContext.getContentResolver(), key,
+                DEFAULT_LEVEL, UserHandle.USER_CURRENT);
+        return Math.max(0f, Math.min(1f, value));
+    }
+
+    private void setLight(int lightId, float brightness) {
+        LogicalLight light = mLightsManager.getLight(lightId);
+        if (light == null) {
+            return;
+        }
+        if (brightness <= 0f) {
+            light.turnOff();
+        } else {
+            light.setBrightness(brightness);
+        }
+    }
+}
