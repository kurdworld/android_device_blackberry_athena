diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/KeyboardPinDigitBuffer.kt b/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/KeyboardPinDigitBuffer.kt
