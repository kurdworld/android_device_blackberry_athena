+    private fun pinKeyCode(event: android.view.KeyEvent): Int {
+        val keyCode = event.keyCode
+        if (keyCode in KEYCODE_0..KEYCODE_9) return keyCode
+        val enabled =
+            Settings.Secure.getInt(applicationContext.contentResolver, "keyboard_pin_input", 1) ==
+                1
+        if (!enabled) return keyCode
+        val unicode =
+            event.keyCharacterMap.get(
+                keyCode,
+                android.view.KeyEvent.META_ALT_ON or android.view.KeyEvent.META_ALT_LEFT_ON,
+            )
+        return if (unicode >= '0'.code && unicode <= '9'.code) {
+            KEYCODE_0 + (unicode - '0'.code)
+        } else {
+            keyCode
+        }
+    }
