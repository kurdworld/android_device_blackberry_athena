+    /**
+     * Launches the component the user picked for the double-press power button gesture.
+     */
+    private boolean handleCustomAppDoubleTapPower() {
+        final String flat = Settings.Secure.getStringForUser(mContext.getContentResolver(),
+                DOUBLE_TAP_POWER_BUTTON_GESTURE_COMPONENT, mUserId);
+        if (TextUtils.isEmpty(flat)) {
+            return false;
+        }
+        final ComponentName component = ComponentName.unflattenFromString(flat);
+        if (component == null) {
+            Slog.w(TAG, "Invalid custom double tap power component: " + flat);
+            return false;
+        }
+        final Intent intent = new Intent(Intent.ACTION_MAIN)
+                .addCategory(Intent.CATEGORY_LAUNCHER)
+                .setComponent(component)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK
+                        | Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED);
+        try {
+            mContext.startActivityAsUser(intent, UserHandle.of(mUserId));
+            return true;
+        } catch (Exception e) {
+            Slog.w(TAG, "Unable to launch custom double tap power app " + component, e);
+            return false;
+        }
+    }
