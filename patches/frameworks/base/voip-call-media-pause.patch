+    /**
+     * Pause media playback when a call starts, so music does not keep playing over the
+     * call (for example over Bluetooth SCO in a car). Only sessions that are actually
+     * playing are paused; the call app's own session and other call apps' voice
+     * sessions are left alone.
+     *
+     * @param callPackage package that owns the audio mode, or null if unknown
+     */
+    private void pauseMediaForCall(@Nullable String callPackage) {
+        final List<MediaController> controllers;
+        try {
+            controllers = getMediaSessionManager().getActiveSessions(null);
+        } catch (Exception e) {
+            Log.w(TAG, "pauseMediaForCall: cannot get media sessions", e);
+            return;
+        }
+        final List<MediaController> paused = new ArrayList<>();
+        for (MediaController controller : controllers) {
+            try {
+                if (callPackage != null && callPackage.equals(controller.getPackageName())) {
+                    continue;
+                }
+                final PlaybackState state = controller.getPlaybackState();
+                if (state == null || state.getState() != PlaybackState.STATE_PLAYING) {
+                    continue;
+                }
+                final MediaController.PlaybackInfo info = controller.getPlaybackInfo();
+                final AudioAttributes attributes = info != null
+                        ? info.getAudioAttributes() : null;
+                if (attributes != null) {
+                    final int usage = attributes.getUsage();
+                    // Leave other call apps' voice sessions alone. Anything else that is
+                    // playing is media the user does not want mixed into the call; players
+                    // often report USAGE_UNKNOWN, so this must not require USAGE_MEDIA.
+                    if (usage == AudioAttributes.USAGE_VOICE_COMMUNICATION
+                            || usage == AudioAttributes.USAGE_VOICE_COMMUNICATION_SIGNALLING) {
+                        continue;
+                    }
+                }
+                controller.getTransportControls().pause();
+                paused.add(controller);
+                Log.i(TAG, "pauseMediaForCall: paused " + controller.getPackageName());
+            } catch (Exception e) {
+                Log.w(TAG, "pauseMediaForCall: cannot pause "
+                        + controller.getPackageName(), e);
+            }
+        }
+        synchronized (mCallPausedSessions) {
+            mCallPausedSessions.addAll(paused);
+        }
+    }
+
+    /** Resume the media sessions that {@link #pauseMediaForCall} paused. */
+    private void resumeMediaAfterCall() {
+        final List<MediaController> paused;
+        synchronized (mCallPausedSessions) {
+            if (mCallPausedSessions.isEmpty()) {
+                return;
+            }
+            paused = new ArrayList<>(mCallPausedSessions);
+            mCallPausedSessions.clear();
+        }
+        for (MediaController controller : paused) {
+            try {
+                final PlaybackState state = controller.getPlaybackState();
+                // Only resume a session that is still paused: if the user
+                // started something else during the call, leave it alone.
+                if (state != null && state.getState() == PlaybackState.STATE_PAUSED) {
+                    controller.getTransportControls().play();
+                    Log.i(TAG, "resumeMediaAfterCall: resumed "
+                            + controller.getPackageName());
+                }
+            } catch (Exception e) {
+                Log.w(TAG, "resumeMediaAfterCall: cannot resume "
+                        + controller.getPackageName(), e);
+            }
+        }
+    }
