+    /**
+     * Copies the old Settings > Keyboard Secure values into the new per-gesture settings. The old
+     * Home value (3) becomes Default because 3 now means Super. The Function key now has a single
+     * action, so an old long-press action is folded into the short-press setting and long/double
+     * are reset to fall back to it.
+     */
+    private static void migrateBlackBerryKeys(ContentResolver resolver) {
+        for (BlackBerryKeys.Key key : BlackBerryKeys.Key.values()) {
+            final int legacy = Settings.Secure.getIntForUser(resolver,
+                    BlackBerryKeys.legacyActionSetting(key),
+                    BlackBerryKeys.Action.DEFAULT.ordinal(), UserHandle.USER_CURRENT);
+            final int action;
+            switch (legacy) {
+                case 1:
+                    action = BlackBerryKeys.Action.CTRL.ordinal();
+                    break;
+                case 2:
+                    action = BlackBerryKeys.Action.TAB.ordinal();
+                    break;
+                case 4:
+                    action = BlackBerryKeys.Action.CUSTOM_APP.ordinal();
+                    break;
+                default:
+                    action = BlackBerryKeys.Action.DEFAULT.ordinal();
+                    break;
+            }
+
+            final String shortSetting = BlackBerryKeys.actionSetting(key,
+                    BlackBerryKeys.Gesture.SHORT_PRESS);
+            if (LineageSettings.System.getIntForUser(resolver, shortSetting, -1,
+                    UserHandle.USER_CURRENT) < 0) {
+                LineageSettings.System.putIntForUser(resolver, shortSetting, action,
+                        UserHandle.USER_CURRENT);
+            }
+
+            if (action == BlackBerryKeys.Action.CUSTOM_APP.ordinal()) {
+                final String customSetting = BlackBerryKeys.customAppSetting(key,
+                        BlackBerryKeys.Gesture.SHORT_PRESS);
+                if (LineageSettings.System.getStringForUser(resolver, customSetting,
+                        UserHandle.USER_CURRENT) == null) {
+                    final String legacyApp = Settings.Secure.getStringForUser(resolver,
+                            BlackBerryKeys.legacyCustomAppSetting(key),
+                            UserHandle.USER_CURRENT);
+                    if (legacyApp != null) {
+                        LineageSettings.System.putStringForUser(resolver, customSetting,
+                                legacyApp, UserHandle.USER_CURRENT);
+                    }
+                }
+            }
+        }
+
+        final int functionShort = LineageSettings.System.getIntForUser(resolver,
+                LineageSettings.System.BLACKBERRY_KEY_FUNCTION_SHORT_PRESS_ACTION,
+                -1, UserHandle.USER_CURRENT);
+        final int functionLong = LineageSettings.System.getIntForUser(resolver,
+                LineageSettings.System.BLACKBERRY_KEY_FUNCTION_LONG_PRESS_ACTION,
+                -1, UserHandle.USER_CURRENT);
+        if (functionShort == BlackBerryKeys.Action.DEFAULT.ordinal()
+                && functionLong > BlackBerryKeys.Action.DEFAULT.ordinal()) {
+            LineageSettings.System.putIntForUser(resolver,
+                    LineageSettings.System.BLACKBERRY_KEY_FUNCTION_SHORT_PRESS_ACTION,
+                    functionLong, UserHandle.USER_CURRENT);
+            if (functionLong == BlackBerryKeys.Action.CUSTOM_APP.ordinal()) {
+                final String longApp = LineageSettings.System.getStringForUser(resolver,
+                        LineageSettings.System.BLACKBERRY_KEY_FUNCTION_LONG_PRESS_CUSTOM_APP,
+                        UserHandle.USER_CURRENT);
+                if (longApp != null) {
+                    LineageSettings.System.putStringForUser(resolver,
+                            LineageSettings.System.BLACKBERRY_KEY_FUNCTION_SHORT_PRESS_CUSTOM_APP,
+                            longApp, UserHandle.USER_CURRENT);
+                }
+            }
+        }
+        if (functionShort >= 0) {
+            // The Function key has one action; long and double fall back to it.
+            LineageSettings.System.putIntForUser(resolver,
+                    LineageSettings.System.BLACKBERRY_KEY_FUNCTION_LONG_PRESS_ACTION,
+                    BlackBerryKeys.Action.DEFAULT.ordinal(), UserHandle.USER_CURRENT);
+            LineageSettings.System.putIntForUser(resolver,
+                    LineageSettings.System.BLACKBERRY_KEY_FUNCTION_DOUBLE_PRESS_ACTION,
+                    BlackBerryKeys.Action.DEFAULT.ordinal(), UserHandle.USER_CURRENT);
+        }
+    }
+
+    private void initBlackBerryPreferences() {
+        for (BlackBerryKeys.Key key : BlackBerryKeys.Key.values()) {
+            for (BlackBerryKeys.Gesture gesture : BlackBerryKeys.Gesture.values()) {
+                final ListPreference pref =
+                        findPreference(blackBerryPreferenceKey(key, gesture));
+                if (pref == null) {
+                    continue;
+                }
+                final int action = BlackBerryKeys.getAction(getContentResolver(), key, gesture,
+                        UserHandle.USER_CURRENT);
+                pref.setValue(Integer.toString(action));
+                pref.setOnPreferenceChangeListener(this);
+                updateBlackBerrySummary(pref, action);
+            }
+        }
+
+        final SwitchPreferenceCompat wakeScreen =
+                findPreference(KEY_CONVENIENCE_WAKE_SCREEN);
+        if (wakeScreen != null) {
+            wakeScreen.setChecked(LineageSettings.System.getInt(getContentResolver(),
+                    LineageSettings.System.ASSIST_WAKE_SCREEN, 0) == 1);
+            wakeScreen.setOnPreferenceChangeListener((preference, newValue) -> {
+                LineageSettings.System.putInt(getContentResolver(),
+                        LineageSettings.System.ASSIST_WAKE_SCREEN,
+                        (Boolean) newValue ? 1 : 0);
+                return true;
+            });
+        }
+    }
