+    @Override
+    public boolean onPreferenceTreeClick(@NonNull Preference preference) {
+        final boolean handled = super.onPreferenceTreeClick(preference);
+        if (PREF_KEY_CUSTOM_APP.equals(preference.getKey())) {
+            showAppPicker();
+            return true;
+        }
+        return handled;
+    }
+
+    private void showAppPicker() {
+        final List<AppEntry> apps = loadAppEntries(mContext);
+        if (apps.isEmpty()) {
+            return;
+        }
+        new AlertDialog.Builder(mContext)
+                .setTitle(R.string.double_tap_power_custom_app_action_title)
+                .setAdapter(new AppPickerAdapter(mContext, apps), (dialog, which) -> {
+                    final AppEntry app = apps.get(which);
+                    DoubleTapPowerSettingsUtils.setDoubleTapPowerButtonGestureComponent(
+                            mContext, app.value);
+                    DoubleTapPowerSettingsUtils.setDoubleTapPowerButtonForCustomAppLaunch(mContext);
+                    updatePreferenceStates();
+                    dialog.dismiss();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static List<AppEntry> loadAppEntries(Context context) {
+        final PackageManager pm = context.getPackageManager();
+        final Intent launcher = new Intent(Intent.ACTION_MAIN)
+                .addCategory(Intent.CATEGORY_LAUNCHER);
+        final List<ResolveInfo> resolved = pm.queryIntentActivities(launcher, 0);
+        resolved.sort((a, b) -> a.loadLabel(pm).toString()
+                .compareToIgnoreCase(b.loadLabel(pm).toString()));
+        final List<AppEntry> apps = new ArrayList<>(resolved.size());
+        for (ResolveInfo info : resolved) {
+            final ActivityInfo ai = info.activityInfo;
+            apps.add(new AppEntry(ai.loadLabel(pm),
+                    new ComponentName(ai.packageName, ai.name).flattenToString(),
+                    ai.loadIcon(pm)));
+        }
+        return apps;
+    }
+
+    private static final class AppEntry {
+        final CharSequence label;
+        final String value;
+        final Drawable icon;
+
+        AppEntry(CharSequence label, String value, Drawable icon) {
+            this.label = label;
+            this.value = value;
+            this.icon = icon;
+        }
+    }
+
+    private static final class AppPickerAdapter extends BaseAdapter {
+        private final LayoutInflater mInflater;
+        private final List<AppEntry> mApps;
+
+        AppPickerAdapter(Context context, List<AppEntry> apps) {
+            mInflater = LayoutInflater.from(context);
+            mApps = apps;
+        }
+
+        @Override
+        public int getCount() {
+            return mApps.size();
+        }
+
+        @Override
+        public AppEntry getItem(int position) {
+            return mApps.get(position);
+        }
+
+        @Override
+        public long getItemId(int position) {
+            return position;
+        }
+
+        @Override
+        public View getView(int position, View convertView, ViewGroup parent) {
+            final View view = convertView != null
+                    ? convertView
+                    : mInflater.inflate(R.layout.app_picker_item, parent, false);
+            final AppEntry app = getItem(position);
+            ((ImageView) view.findViewById(R.id.app_icon)).setImageDrawable(app.icon);
+            ((TextView) view.findViewById(R.id.app_name)).setText(app.label);
+            return view;
+        }
+    }
+
