+    private int getStoredKeyboardLayout() {
+        final int layout = Secure.getInt(requireContext().getContentResolver(),
+                SETTING_PHYSICAL_KEYBOARD_LAYOUT, 0);
+        return (layout < 0 || layout > 3) ? 0 : layout;
+    }
+
+    /**
+     * Applies the user-selected layout on top of the layout detected from the keyboard hardware.
+     * The layout is expressed as key remappings, so it takes effect immediately and is stored by
+     * the input stack for the next boot.
+     */
+    private void applyKeyboardLayout(int layout) {
+        final InputManager im = requireContext().getSystemService(InputManager.class);
+        if (im == null) {
+            return;
+        }
+        // Clear the letter remappings this setting owns.
+        for (int key : LAYOUT_REMAPPED_KEYS) {
+            im.remapModifierKey(key, key);
+        }
+        if (layout == 0) {
+            return;
+        }
+        final int[] base = getBaseLayout(getDetectedKeyboardLayout());
+        final int[] target;
+        switch (layout) {
+            case 1:
+                target = LAYOUT_QWERTY;
+                break;
+            case 2:
+                target = LAYOUT_AZERTY;
+                break;
+            case 3:
+                target = LAYOUT_QWERTZ;
+                break;
+            default:
+                return;
+        }
+        for (int i = 0; i < base.length; i++) {
+            if (base[i] != target[i]) {
+                im.remapModifierKey(base[i], target[i]);
+            }
+        }
+    }
+
+    private static int[] getBaseLayout(String layout) {
+        if ("azerty".equals(layout)) {
+            return LAYOUT_AZERTY;
+        }
+        if ("qwertz".equals(layout)) {
+            return LAYOUT_QWERTZ;
+        }
+        return LAYOUT_QWERTY;
+    }
+
+    private String getDetectedKeyboardLayout() {
+        final InputManager im = requireContext().getSystemService(InputManager.class);
+        if (im != null) {
+            for (int id : im.getInputDeviceIds()) {
+                final InputDevice device = im.getInputDevice(id);
+                if (device == null) {
+                    continue;
+                }
+                final String name = device.getName();
+                if (name == null || !name.startsWith("stmpe")) {
+                    continue;
+                }
+                if (name.contains("azerty")) {
+                    return "azerty";
+                }
+                if (name.contains("qwertz")) {
+                    return "qwertz";
+                }
+                return "qwerty";
+            }
+        }
+        return "qwerty";
+    }
