new file mode 100644
index 00000000..ad468332
--- /dev/null
+++ b/sdk/src/java/org/lineageos/internal/util/BlackBerryKeys.java
@@ -0,0 +1,207 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.internal.util;
+
+import android.content.ContentResolver;
+import android.provider.Settings;
+
+import lineageos.providers.LineageSettings;
+
+/**
+ * Settings and action values for the BlackBerry KEY2's Sym, Function and
+ * Convenience keys. Each key has a short press, long press and double press
+ * action, and every action can launch its own app.
+ */
+public final class BlackBerryKeys {
+    public enum Key {
+        SYM,
+        FUNCTION,
+        CONVENIENCE
+    }
+
+    public enum Gesture {
+        SHORT_PRESS,
+        LONG_PRESS,
+        DOUBLE_PRESS
+    }
+
+    public enum Action {
+        DEFAULT,
+        CTRL,
+        TAB,
+        SUPER,
+        CUSTOM_APP;
+
+        public static Action fromIntSafe(int id) {
+            if (id < DEFAULT.ordinal() || id >= Action.values().length) {
+                return DEFAULT;
+            }
+            return Action.values()[id];
+        }
+    }
+
+    private static final String LEGACY_SYM_ACTION = "blackberry_key_sym_action";
+    private static final String LEGACY_FUNCTION_ACTION = "blackberry_key_function_action";
+    private static final String LEGACY_CONVENIENCE_ACTION =
+            "blackberry_key_convenience_action";
+    private static final String LEGACY_SYM_CUSTOM_APP =
+            "blackberry_key_sym_custom_app";
+    private static final String LEGACY_FUNCTION_CUSTOM_APP =
+            "blackberry_key_function_custom_app";
+    private static final String LEGACY_CONVENIENCE_CUSTOM_APP =
+            "blackberry_key_convenience_custom_app";
+
+    private BlackBerryKeys() {
+    }
+
+    public static String actionSetting(Key key, Gesture gesture) {
+        switch (key) {
+            case SYM:
+                switch (gesture) {
+                    case SHORT_PRESS:
+                        return LineageSettings.System.BLACKBERRY_KEY_SYM_SHORT_PRESS_ACTION;
+                    case LONG_PRESS:
+                        return LineageSettings.System.BLACKBERRY_KEY_SYM_LONG_PRESS_ACTION;
+                    case DOUBLE_PRESS:
+                        return LineageSettings.System.BLACKBERRY_KEY_SYM_DOUBLE_PRESS_ACTION;
+                }
+                break;
+            case FUNCTION:
+                switch (gesture) {
+                    case SHORT_PRESS:
+                        return LineageSettings.System.BLACKBERRY_KEY_FUNCTION_SHORT_PRESS_ACTION;
+                    case LONG_PRESS:
+                        return LineageSettings.System.BLACKBERRY_KEY_FUNCTION_LONG_PRESS_ACTION;
+                    case DOUBLE_PRESS:
+                        return LineageSettings.System.BLACKBERRY_KEY_FUNCTION_DOUBLE_PRESS_ACTION;
+                }
+                break;
+            case CONVENIENCE:
+                switch (gesture) {
+                    case SHORT_PRESS:
+                        return LineageSettings.System
+                                .BLACKBERRY_KEY_CONVENIENCE_SHORT_PRESS_ACTION;
+                    case LONG_PRESS:
+                        return LineageSettings.System
+                                .BLACKBERRY_KEY_CONVENIENCE_LONG_PRESS_ACTION;
+                    case DOUBLE_PRESS:
+                        return LineageSettings.System
+                                .BLACKBERRY_KEY_CONVENIENCE_DOUBLE_PRESS_ACTION;
+                }
+                break;
+        }
+        throw new IllegalArgumentException("Unknown key/gesture: " + key + "/" + gesture);
+    }
+
+    public static String customAppSetting(Key key, Gesture gesture) {
+        switch (key) {
+            case SYM:
+                switch (gesture) {
+                    case SHORT_PRESS:
+                        return LineageSettings.System.BLACKBERRY_KEY_SYM_SHORT_PRESS_CUSTOM_APP;
+                    case LONG_PRESS:
+                        return LineageSettings.System.BLACKBERRY_KEY_SYM_LONG_PRESS_CUSTOM_APP;
+                    case DOUBLE_PRESS:
+                        return LineageSettings.System.BLACKBERRY_KEY_SYM_DOUBLE_PRESS_CUSTOM_APP;
+                }
+                break;
+            case FUNCTION:
+                switch (gesture) {
+                    case SHORT_PRESS:
+                        return LineageSettings.System
+                                .BLACKBERRY_KEY_FUNCTION_SHORT_PRESS_CUSTOM_APP;
+                    case LONG_PRESS:
+                        return LineageSettings.System
+                                .BLACKBERRY_KEY_FUNCTION_LONG_PRESS_CUSTOM_APP;
+                    case DOUBLE_PRESS:
+                        return LineageSettings.System
+                                .BLACKBERRY_KEY_FUNCTION_DOUBLE_PRESS_CUSTOM_APP;
+                }
+                break;
+            case CONVENIENCE:
+                switch (gesture) {
+                    case SHORT_PRESS:
+                        return LineageSettings.System
+                                .BLACKBERRY_KEY_CONVENIENCE_SHORT_PRESS_CUSTOM_APP;
+                    case LONG_PRESS:
+                        return LineageSettings.System
+                                .BLACKBERRY_KEY_CONVENIENCE_LONG_PRESS_CUSTOM_APP;
+                    case DOUBLE_PRESS:
+                        return LineageSettings.System
+                                .BLACKBERRY_KEY_CONVENIENCE_DOUBLE_PRESS_CUSTOM_APP;
+                }
+                break;
+        }
+        throw new IllegalArgumentException("Unknown key/gesture: " + key + "/" + gesture);
+    }
+
+    public static String legacyActionSetting(Key key) {
+        switch (key) {
+            case SYM:
+                return LEGACY_SYM_ACTION;
+            case FUNCTION:
+                return LEGACY_FUNCTION_ACTION;
+            case CONVENIENCE:
+                return LEGACY_CONVENIENCE_ACTION;
+            default:
+                throw new IllegalArgumentException("Unknown key: " + key);
+        }
+    }
+
+    public static String legacyCustomAppSetting(Key key) {
+        switch (key) {
+            case SYM:
+                return LEGACY_SYM_CUSTOM_APP;
+            case FUNCTION:
+                return LEGACY_FUNCTION_CUSTOM_APP;
+            case CONVENIENCE:
+                return LEGACY_CONVENIENCE_CUSTOM_APP;
+            default:
+                throw new IllegalArgumentException("Unknown key: " + key);
+        }
+    }
+
+    /**
+     * Returns the action stored for a gesture, falling back to the old
+     * Settings > Keyboard value for the short press. The old Home value (3)
+     * is mapped to Default because 3 now means Super.
+     */
+    public static int getAction(ContentResolver cr, Key key, Gesture gesture, int user) {
+        final int action = LineageSettings.System.getIntForUser(cr,
+                actionSetting(key, gesture), -1, user);
+        if (action >= 0) {
+            return Action.fromIntSafe(action).ordinal();
+        }
+        if (gesture == Gesture.SHORT_PRESS) {
+            int legacy = Settings.Secure.getIntForUser(cr,
+                    legacyActionSetting(key), Action.DEFAULT.ordinal(), user);
+            if (legacy < Action.DEFAULT.ordinal()
+                    || legacy >= Action.values().length
+                    || legacy == Action.SUPER.ordinal()) {
+                legacy = Action.DEFAULT.ordinal();
+            }
+            return legacy;
+        }
+        return Action.DEFAULT.ordinal();
+    }
+
+    /**
+     * Returns the component stored for a gesture, falling back to the old
+     * Settings > Keyboard value for the short press.
+     */
+    public static String getCustomApp(ContentResolver cr, Key key, Gesture gesture, int user) {
+        final String app = LineageSettings.System.getStringForUser(cr,
+                customAppSetting(key, gesture), user);
+        if (app != null) {
+            return app;
+        }
+        if (gesture == Gesture.SHORT_PRESS) {
+            return Settings.Secure.getStringForUser(cr,
+                    legacyCustomAppSetting(key), user);
+        }
+        return null;
+    }
+}
