<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.blackberry.settings">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:label="@string/device_settings_title"
        android:icon="@drawable/ic_keyboard"
        android:theme="@style/Theme.SubSettingsBase"
        android:supportsRtl="true">

        <activity
            android:name=".DeviceSettingsActivity"
            android:label="@string/device_settings_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/device_settings_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_keyboard" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-256" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
        </activity>

        <!-- Opened from BlackBerry settings > Troubleshooting > Collect logs -->
        <activity
            android:name=".CollectLogsActivity"
            android:label="@string/collect_logs_title"
            android:exported="false" />

        <service
            android:name=".KeyboardTileService$Touchpad"
            android:label="@string/keyboard_touchpad_enabled_title"
            android:icon="@drawable/ic_keyboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".KeyboardTileService$Scrolling"
            android:label="@string/keyboard_scrolling_enabled_title"
            android:icon="@drawable/ic_keyboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
